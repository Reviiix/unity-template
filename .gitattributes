# Text files are stored with LF line endings.
*.cs        text eol=lf diff=csharp
*.asmdef    text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.shader    text eol=lf

# Unity YAML assets: always text, never re-wrapped.
*.unity     text eol=lf
*.prefab    text eol=lf
*.asset     text eol=lf
*.meta      text eol=lf
*.mat       text eol=lf
*.anim      text eol=lf
*.controller text eol=lf

# Binary assets.
*.png  binary
*.jpg  binary
*.psd  binary
*.mp3  binary
*.wav  binary
*.ttf  binary
*.otf  binary
*.dll  binary
*.so   binary
*.a    binary
